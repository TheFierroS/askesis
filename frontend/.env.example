# Backend'in adresi.
# Yerelde uvicorn'un dinlediği port; üretimde kendi API alan adın.
# NEXT_PUBLIC_ öneki bu değerin tarayıcıya gömüleceği anlamına geliyor —
# buraya asla gizli bir şey yazma.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clerk publishable key. Tarayıcıda görünür, gizli değil.
# Yerelde pk_test_ ile başlar, üretimde pk_live_ ile.
# Test anahtarı canlıda ÇALIŞMAZ.
# Clerk Dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key. Yalnızca sunucu tarafında kullanılıyor.
# NEXT_PUBLIC_ öneki YOK ve olmamalı — olsaydı istemci paketine girerdi.
CLERK_SECRET_KEY=sk_test_...