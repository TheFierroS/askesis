# ============================================================
# Askesis — ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyala ve değerleri doldur.
# `.env` ASLA git deposuna girmemeli (.gitignore içinde olmalı).
# ============================================================

# --- LLM sağlayıcıları -------------------------------------
# En az biri zorunlu. Üçü de tanımlıysa biri düşünce diğeri devralıyor —
# ücretsiz katmanlarda kota ve geçici arızalar sık, zincir bunu karşılıyor.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# --- Kimlik doğrulama --------------------------------------
# Üretimde MUTLAKA false. true iken JWT doğrulanmıyor, X-User-Id başlığına
# güveniliyor; bu haliyle açık bir sunucu herkesin herkesin yerine geçmesi
# demek.
AUTH_DEV_MODE=false

CLERK_JWKS_URL=https://<senin-clerk-alan-adin>/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=["https://askesis.com"]
CLERK_ADMIN_USER_IDS=["user_xxxxxxxxxxxxxxxx"]

# Admin panelinde kullanıcı adı ve e-postası göstermek için.
# Boş bırakılırsa panel yalnızca kimlikleri gösterir, hata vermez.
CLERK_SECRET_KEY=

# --- Ağ ------------------------------------------------------
# Tarayıcıdan istek atacak alan adları. Üretim alan adını eklemek ZORUNLU.
# Asla ["*"] yazma: kimlik doğrulamalı isteklerde her siteye açık kapı demek.
ALLOWED_ORIGINS=["https://askesis.com","https://www.askesis.com"]

# --- Veri ----------------------------------------------------
SQLITE_PATH=./data/pool.db
CHROMA_PATH=./data/chroma
UPLOADS_PATH=./data/uploads

# --- Krediler ------------------------------------------------
# Yeni kullanıcıya verilen ücretsiz soru hakkı.
FREE_CREDITS=20

# --- Havuz ---------------------------------------------------
# 0 = sınırsız: worker üretebildiği sürece üretmeye devam eder.
# Yayın öncesi havuzu doldurmak için doğru ayar bu.
POOL_MIN_SIZE=0
REFILL_INTERVAL_MINUTES=10
# Kaç boş turdan SONRA geri çekilmeye başlansın.
REFILL_GRACE_ROUNDS=2

# --- Marka ---------------------------------------------------
# PDF altbilgisinde geçiyor. Frontend'deki lib/brand.ts ile aynı olmalı.
BRAND_NAME=Askesis

# --- Loglama -------------------------------------------------
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- OCR (Windows'ta genelde otomatik bulunuyor) -------------
# Linux'ta apt ile kurulduysa boş bırak.
TESSERACT_CMD=
